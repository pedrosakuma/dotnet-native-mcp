<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1305;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetNativeMcp.Cli\DotnetNativeMcp.Cli.csproj" />
  </ItemGroup>

  <!-- The NativeAOT fixture is built once by DotnetNativeMcp.Core.Tests's
       BuildNativeAotFixture target (BeforeTargets="Build"). Do NOT duplicate
       that `dotnet publish` invocation here: two concurrent publishes of the
       same tests/fixtures/SampleAot project race on the native link step and
       corrupt the output. CliFixturePaths/CliTestHarness read the raw publish
       output (tests/fixtures/SampleAot/bin/Release/net10.0/linux-x64/) directly. -->

</Project>
